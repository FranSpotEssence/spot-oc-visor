# ── Microsoft Azure App Registration ──────────────────────────────
# Obtén estos valores en: portal.azure.com → Azure Active Directory → App registrations
AZURE_TENANT_ID=tu-tenant-id-aqui
AZURE_CLIENT_ID=tu-client-id-aqui
AZURE_CLIENT_SECRET=tu-client-secret-aqui

# ── OneDrive / SharePoint ──────────────────────────────────────────
# Email del usuario dueño del OneDrive donde está el Excel
ONEDRIVE_USER_EMAIL=francisca.lagos@spotessence.cl
# Ruta del archivo dentro del OneDrive (relativa a la raíz)
EXCEL_FILE_PATH=LOGÍSTICA - Documentos/Seguimientos OCs.xlsx

# ── App Settings ──────────────────────────────────────────────────
# Intervalo de actualización en minutos (default: 60)
REFRESH_INTERVAL_MINUTES=60
# Puerto (Railway lo asigna automáticamente)
PORT=5000
# Entorno (development / production)
FLASK_ENV=production
